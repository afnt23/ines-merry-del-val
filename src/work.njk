---
layout: layouts/base.njk
pagination:
  data: works
  size: 1
  alias: item
eleventyComputed:
  permalink: "{{ item.url }}"
  title: "{{ item.title }}"
  description: "{{ item.title }}"
  nav: "{{ item.slug }}"
---
<article class="work-detail{% if not item.image %} work-detail--text{% endif %}">
  {% if item.images.length %}
  <div class="work-masonry" data-lightbox aria-label="{{ item.title }} photo gallery">
    {% for img in item.images %}
    <div class="masonry-item" style="aspect-ratio: {{ img.width }} / {{ img.height }}">
      <button type="button" class="image-tile" data-index="{{ loop.index0 }}" aria-label="Open photo {{ loop.index }}">
        <img
          class="gallery-image"
          src="{{ img.src }}"
          alt="{{ item.title }}"
          width="{{ img.width }}"
          height="{{ img.height }}"
          loading="{% if loop.index0 < 8 %}eager{% else %}lazy{% endif %}"
          {% if loop.index0 < 4 %}fetchpriority="high"{% endif %}
        >
      </button>
    </div>
    {% endfor %}
  </div>
  {% elif item.image %}
  <div class="work-image">
    <img src="{{ item.image }}" alt="{{ item.title }}">
  </div>
  {% endif %}

  <div class="work-meta">
    <h1 class="work-title">{{ item.title }}</h1>
    {% if item.location %}<p class="work-sub">{{ item.location }}</p>{% endif %}
    {% if item.publication %}<p class="work-publication">{{ item.publication }}</p>{% endif %}
  </div>
</article>

<section class="related-works">
  <h2 class="section-label">Related Works</h2>
  <div class="related-row">
    {% for other in works %}
    {% if other.slug != item.slug %}
    <a class="related-tile" href="{{ other.url }}">
      <img class="related-image grid-image" src="{{ other.image }}" alt="{{ other.title }}" loading="lazy" width="800" height="800">
      <span class="related-title">{{ other.title }}</span>
    </a>
    {% endif %}
    {% endfor %}
  </div>
</section>

{% if item.images.length %}
<div class="lightbox" id="lightbox" hidden>
  <div class="lightbox-topbar">
    <span class="lightbox-counter" id="lightbox-counter"></span>
    <button type="button" class="lightbox-close" id="lightbox-close">Close</button>
  </div>
  <div class="lightbox-stage" id="lightbox-stage">
    <img class="lightbox-image" id="lightbox-image" alt="{{ item.title }}">
  </div>
  <div class="lightbox-hint">← → navigate&nbsp;&nbsp;·&nbsp;&nbsp;esc close</div>
  <button type="button" class="lightbox-prev" id="lightbox-prev" aria-label="Previous">‹</button>
  <button type="button" class="lightbox-next" id="lightbox-next" aria-label="Next">›</button>
</div>
{% endif %}
